{
  "name": "wychwytywacz",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "build": {
    "appId": "com.wychwytywacz.app",
    "productName": "Wychwytywacz",
    "files": [
      "main.js",
      "preload.js",
      "frontend/loading.html"
    ],
    "extraResources": [
      { "from": "backend/dist/audio-backend", "to": "backend/audio-backend", "filter": ["**/*"] },
      { "from": "frontend", "to": "frontend", "filter": ["**/*"] },
      { "from": "vendor/ffmpeg", "to": "bin", "filter": ["ffmpeg", "ffprobe", "ffmpeg.exe", "ffprobe.exe"] }
    ],
    "mac": {
      "target": ["dmg"],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aplikacja potrzebuje mikrofonu do nagrywania audio do transkrypcji."
      }
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}